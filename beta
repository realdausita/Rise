function getFlyDirection()
camCF = Workspace.CurrentCamera.CFrame
moveVector = FlyCtrl and FlyCtrl:GetMoveVector() or Vector3.new(0,0,0)
if moveVector.Magnitude < 0.01 then return Vector3.new(0, 0, 0) end
forward = camCF.LookVector
right = camCF.RightVector
return (forward * -moveVector.Z + right * moveVector.X).Unit * FlyState.speed
end
function flyUpdate(self, dt)
FlyState.origUpdate(self, dt)
local hrp = self.Character and self.Character:FindFirstChild("HumanoidRootPart")
if not hrp then return end
flyDir = getFlyDirection()
if flyDir.Magnitude > 0.1 then
FlyState.freezeY = nil
elseif not FlyState.freezeY then
FlyState.freezeY = hrp.Position.Y
end
newVel = flyDir
if self.DataRegistry then self.DataRegistry:Set("Velocity", newVel * 90) end
hrp.AssemblyLinearVelocity = newVel
if FlyState.freezeY and flyDir.Magnitude <= 0.1 then
pos = hrp.Position
hrp.CFrame = CFrame.new(pos.X, FlyState.freezeY, pos.Z) * (hrp.CFrame - hrp.CFrame.Position)
end
end
function StartFly()
if FlyState.active then return end
FlyState.active = true
FlyState.freezeY = nil
if FlyMod then FlyMod.Update = flyUpdate end
end
function StopFly()
if not FlyState.active then return end
FlyState.active = false
FlyState.freezeY = nil
if FlyMod then FlyMod.Update = FlyState.origUpdate end
end
