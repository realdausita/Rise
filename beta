local function isPlayerDowned(player, model)
if not model and player then model = player.Character end
if not model then return false end
if player and CharacterService then
local ok, res = pcall(function()
local charData = CharacterService:GetCharacterFromPlayer(player)
if charData and charData.DataRegistry then
return charData.DataRegistry:Get("Downed")
end
end)
if ok and res == true then return true end
end
if model:GetAttribute("Downed") == true or model:FindFirstChild("Downed") then
return true
end
local hum = model:FindFirstChildOfClass("Humanoid")
if hum and (hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Physics or hum:GetState() == Enum.HumanoidStateType.Dead) then
return true
end
return false
end
local function isEvadeNextbot(model)
if not model or not model:IsA("Model") then return false end
if model.Name == LocalPlayer.Name then return false end
local team = model:GetAttribute("Team")
if team and team ~= "PlayerTeam" then
return true
end
if model:FindFirstChild("Hitbox") then
return true
end
if not Players:FindFirstChild(model.Name) and not Players:GetPlayerFromCharacter(model) then
if model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildOfClass("Humanoid") then
return true
end
end
return false
end
