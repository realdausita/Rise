local UserInputService = game:GetService("UserInputService")
btn.Font = opts.font or Enum.Font.GothamBold
btn.TextSize = opts.textSize or 18
btn.TextColor3 = opts.textColor or Color3.new(1, 1, 1)
btn.TextStrokeTransparency = opts.textStrokeTransparency or 0.5
