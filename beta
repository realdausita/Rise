local function getEmoteIDByName(name)
if not useInventoryLoaded then return nil end
local ownedIds = useInventory.OwnedIds()
for _, id in ipairs(ownedIds) do
local config = Registry.GetConfig(id)
if config and config.EquipInfo and config.EquipInfo.SlotType == "Emote" then
local itemData = Registry.GetById(id)
local itemName = nil
if itemData then
local module = itemData.Module
if type(module) == "string" then
itemName = module
elseif typeof(module) == "Instance" then
itemName = module.Name
end
end
if itemName and itemName:lower() == name:lower() then
return id
end
end
end
return nil
end
local function isEmoteOwned(emoteId)
if not useInventoryLoaded then return true end
local ownedIds = useInventory.OwnedIds()
for _, id in ipairs(ownedIds) do
