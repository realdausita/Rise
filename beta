function updateESP()
if not ESPManager.Rendering or not ESPManager.WindowFocused then return end
if not workspace.CurrentCamera then return end
ESPManager.UpdateCounter = ESPManager.UpdateCounter + 1
if ESPManager.UpdateCounter % ESPManager.UpdateInterval ~= 0 then return end
local aliveTargets = {}
local downedTargets = {}
for _, player in ipairs(Players:GetPlayers()) do
if player == LocalPlayer then continue end
local char = player.Character
if not char then continue end
local hum = char:FindFirstChild("Humanoid")
if not hum then continue end
local downed = isPlayerDowned(player, char)
if downed then
table.insert(downedTargets, { model = char, name = player.Name .. " [DOWN]" })
elseif hum.Health > 0 then
table.insert(aliveTargets, { model = char, name = player.Name })
end
end
updateGenericESP(aliveTargets, Color3.fromRGB(0, 255, 0), ESPManager.Settings, ESPManager.AliveElements)
updateGenericESP(downedTargets, Color3.fromRGB(255, 0, 0), ESPManager.DownedSettings, ESPManager.DownedElements)
local nextbotTargets = {}
local function scanFolderBots(folder)
if not folder then return end
for _, model in ipairs(folder:GetChildren()) do
if isEvadeNextbot(model) then
table.insert(nextbotTargets, { model = model, name = model.Name .. " [BOT]" })
end
end
end
scanFolderBots(workspace:FindFirstChild("Players"))
scanFolderBots(workspace:FindFirstChild("Rigs"))
scanFolderBots(workspace:FindFirstChild("NPCs"))
if workspace:FindFirstChild("Game") then
scanFolderBots(workspace.Game:FindFirstChild("Players"))
scanFolderBots(workspace.Game:FindFirstChild("NPCs"))
end
updateGenericESP(nextbotTargets, Color3.fromRGB(255, 0, 0), ESPManager.NextbotSettings, ESPManager.NextbotElements)
local ticketTargets = {}
local effects = workspace:FindFirstChild("Effects")
if effects then
local ticketsFolder = effects:FindFirstChild("Tickets")
if ticketsFolder then
for _, model in ipairs(ticketsFolder:GetChildren()) do
if model:IsA("Model") or model:IsA("BasePart") then
table.insert(ticketTargets, { model = model, name = model.Name })
end
end
end
end
updateGenericESP(ticketTargets, Color3.fromRGB(0, 150, 255), ESPManager.TicketSettings, ESPManager.TicketElements)
local vehicleTargets = {}
local vehiclesFolder = workspace:FindFirstChild("Vehicles")
if vehiclesFolder then
for _, model in ipairs(vehiclesFolder:GetChildren()) do
if model:IsA("Model") then
table.insert(vehicleTargets, { model = model, name = model.Name })
end
end
end
updateGenericESP(vehicleTargets, Color3.fromRGB(255, 105, 180), ESPManager.VehicleSettings, ESPManager.VehicleElements)
end
