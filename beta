function getSpawns()
local spawnsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Parts") and workspace.Map.Parts:FindFirstChild("Spawns")
if spawnsFolder then
return spawnsFolder:GetChildren()
end
return {}
end
function getObjectives()
local objectives = {}
local gameFolder = workspace:FindFirstChild("Game")
if not gameFolder then return objectives end
local mapFolder = gameFolder:FindFirstChild("Map")
if not mapFolder then return objectives end
local partsFolder = mapFolder:FindFirstChild("Parts")
if not partsFolder then return objectives end
local objectivesFolder = partsFolder:FindFirstChild("Objectives")
if not objectivesFolder then return objectives end
for _, obj in pairs(objectivesFolder:GetChildren()) do
if obj:IsA("Model") then
local primaryPart = obj.PrimaryPart
if not primaryPart then
for _, part in pairs(obj:GetChildren()) do
if part:IsA("BasePart") then
primaryPart = part
break
end
end
end
if primaryPart then
table.insert(objectives, {
Name = obj.Name,
Part = primaryPart,
Position = primaryPart.Position,
Size = primaryPart.Size
})
end
end
end
return objectives
end
local function getDownedModels()
local downed = {}
local scanFolder = function(folder) LPH_ATTRIBUTES(PRESET(FAST), ERROR_HANDLING(false))
if not folder then return end
for _, model in ipairs(folder:GetChildren()) do
if model:IsA("Model") and model.Name ~= LocalPlayer.Name and model:FindFirstChild("HumanoidRootPart") then
local humanoid = model:FindFirstChildOfClass("Humanoid")
local isDown = isPlayerDowned(Players:FindFirstChild(model.Name), model)
if isDown then
table.insert(downed, model)
end
end
end
end
scanFolder(workspace:FindFirstChild("Players"))
local gameFolder = workspace:FindFirstChild("Game")
if gameFolder then
scanFolder(gameFolder:FindFirstChild("Players"))
end
return downed
end
local function getNextbotModels()
local bots = {}
local scanFolder = function(folder) LPH_ATTRIBUTES(PRESET(FAST), ERROR_HANDLING(false))
if not folder then return end
for _, model in ipairs(folder:GetChildren()) do
if isEvadeNextbot(model) and model:FindFirstChild("HumanoidRootPart") then
table.insert(bots, model)
end
end
end
scanFolder(workspace:FindFirstChild("Players"))
local gameFolder = workspace:FindFirstChild("Game")
if gameFolder then
scanFolder(gameFolder:FindFirstChild("Players"))
end
scanFolder(workspace:FindFirstChild("NPCs"))
return bots
end
function teleportToCFrame(cframeOffset)
local hrp = getLocalRoot()
if hrp then
hrp.CFrame = cframeOffset
end
end
function teleportToRandomFromList(list, offset)
if #list > 0 then
local target = list[math.random(1, #list)]
local hrp = target:FindFirstChild("HumanoidRootPart")
if hrp then
teleportToCFrame(hrp.CFrame + offset)
end
end
end
function teleportToRandomPlayer(offset)
local players = {}
for _, plr in ipairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
table.insert(players, plr)
end
end
if #players > 0 then
local target = players[math.random(1, #players)]
teleportToCFrame(target.Character.HumanoidRootPart.CFrame + offset)
end
end
