btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
btn.BorderSizePixel = 0
btn.AutoButtonColor = false
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, opts.cornerRadius or 14)
local gradient = Instance.new("UIGradient")
gradient.Color = opts.colors or ColorSequence.new{
ColorSequenceKeypoint.new(0, Color3.fromRGB(96, 14, 14)),
ColorSequenceKeypoint.new(0.5, Color3.fromRGB(168, 26, 26)),
ColorSequenceKeypoint.new(1, Color3.fromRGB(96, 14, 14))
}
gradient.Rotation = 90
gradient.Parent = btn
local stroke = Instance.new("UIStroke")
stroke.Color = opts.stroke or Color3.fromRGB(255, 110, 110)
stroke.Thickness = opts.strokeThickness or 2
stroke.Transparency = opts.strokeTransparency or 0.3
stroke.Parent = btn
local scale = Instance.new("UIScale")
scale.Parent = btn
local dragActive = false
local dragInput = nil
local dragOffset = Vector2.new()
local dragMoved = 0
local dragLastPosition = nil
local dragConn = nil
local function inputPos2D(input)
return Vector2.new(input.Position.X, input.Position.Y)
end
btn.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
TweenService:Create(scale, TweenInfo.new(0.08), { Scale = 0.97 }):Play()
dragActive = true
dragInput = input
dragMoved = 0
local startPos = inputPos2D(input)
dragLastPosition = startPos
dragOffset = startPos - btn.AbsolutePosition
if dragConn then dragConn:Disconnect() end
dragConn = UserInputService.InputChanged:Connect(function(ci)
if not dragActive then return end
if dragInput and dragInput.UserInputType == Enum.UserInputType.Touch then
if ci ~= dragInput then return end
elseif ci.UserInputType ~= Enum.UserInputType.MouseMovement then
return
end
local curPos = inputPos2D(ci)
if dragLastPosition then
dragMoved = dragMoved + (curPos - dragLastPosition).Magnitude
end
dragLastPosition = curPos
local newPos = curPos - dragOffset
local parentSize = btn.Parent.AbsoluteSize
local btnSize = btn.AbsoluteSize
newPos = Vector2.new(
math.clamp(newPos.X, 0, math.max(0, parentSize.X - btnSize.X)),
math.clamp(newPos.Y, 0, math.max(0, parentSize.Y - btnSize.Y))
)
btn.Position = UDim2.fromOffset(newPos.X, newPos.Y)
end)
end
end)
btn.InputEnded:Connect(function(input)
if input ~= dragInput then return end
dragActive = false
dragInput = nil
dragLastPosition = nil
if dragConn then
dragConn:Disconnect()
dragConn = nil
end
if input.UserInputType == Enum.UserInputType.Touch then
TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
else
TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.04 }):Play()
end
end)
btn.Activated:Connect(function(input)
if input and input.UserInputType == Enum.UserInputType.Keyboard then return end
if dragMoved > 12 then
dragMoved = 0
return
end
local action = buttonActions[btn]
if action then action() end
end)
btn.MouseEnter:Connect(function()
TweenService:Create(scale, TweenInfo.new(0.15), { Scale = 1.04 }):Play()
end)
btn.MouseLeave:Connect(function()
