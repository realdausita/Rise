end
end
function teleportToSelectedPlayer(plr, offset)
if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
teleportToCFrame(plr.Character.HumanoidRootPart.CFrame + offset)
end
end
function teleportToObjective(objectiveName, offset)
local objectives = getObjectives()
for _, obj in ipairs(objectives) do
if obj.Name == objectiveName then
local teleportPosition = obj.Position + offset
local raycastParams = RaycastParams.new()
local char = LocalPlayer.Character
if char then
raycastParams.FilterDescendantsInstances = { char }
end
raycastParams.FilterType = excludeFilterType
local ray = workspace:Raycast(teleportPosition, Vector3.new(0, -10, 0), raycastParams)
if ray then
teleportPosition = ray.Position + Vector3.new(0, 3, 0)
end
teleportToCFrame(CFrame.new(teleportPosition))
return
end
end
end
function ensureSecurityPart()
local existingPart = workspace:FindFirstChild("SecurityPart")
if existingPart then
return existingPart
end
local part = Instance.new("Part")
part.Name = "SecurityPart"
part.Size = Vector3.new(10, 1, 10)
part.Position = Vector3.new(50000, 50000, 50000)
part.Anchored = true
part.CanCollide = true
part.Parent = workspace
return part
end
function teleportToSecurityPart(offset)
local securityPart = ensureSecurityPart()
local hrp = getLocalRoot()
if not hrp then
return
end
local teleportPosition = securityPart.Position + offset
local raycastParams = RaycastParams.new()
local char = LocalPlayer.Character
if char then
raycastParams.FilterDescendantsInstances = { char }
end
raycastParams.FilterType = excludeFilterType
local ray = workspace:Raycast(teleportPosition, Vector3.new(0, -10, 0), raycastParams)
if ray then
teleportPosition = ray.Position + Vector3.new(0, 3, 0)
end
teleportToCFrame(CFrame.new(teleportPosition))
