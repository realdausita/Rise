function startObjectiveFarm()
if not objectiveFarmEnabled then return end
objectivesContainer = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Parts") and workspace.Map.Parts:FindFirstChild("Objectives")
hasObjectives = false
if objectivesContainer then
anyCompleted = false
for _, obj in pairs(objectivesContainer:GetChildren()) do
