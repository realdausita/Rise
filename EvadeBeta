function UnlockAllStart()
        local env = getgenv()
        local prev = env.eu
        local saved = prev and prev.export and prev:export()
        if prev and prev.unload then
            prev:unload()
        end

        local old = env.EvadeUnlock
        if not prev and old then
            saved = old.Export and old:Export()
            if old.Unload then
                old:Unload()
            end
        end

        local players = game:GetService("Players")
        local rs = game:GetService("ReplicatedStorage")
        local run = game:GetService("RunService")
        local http = game:GetService("HttpService")
        local player = players.LocalPlayer
        assert(player, "no player")
        assert(type(hookfunction) == "function", "no hookfunction")

        local hooks = rs.Shared.UserData.ClientHooks
        local reg = require(rs.Items.Registry)
        local inv = require(hooks.useInventory)
        local loadout = require(hooks.useLoadout)
        local chars = require(rs.Services.Asset.CharacterService)
        local pops = require(rs.Services.UI.PopupService)
        local emotes = require(rs.Services.UI.PopupService.Types.Emote)
        local charcls = require(rs.Objects.Game.Character)
        local data_cls = require(rs.Objects.Game.Character.DataRegistry)
        local anims = require(rs.Objects.Game.Character.Animations)
        local slotcls = require(rs.Objects.Menu.Menu.Views.Inventory.Views.Slots)
        local builder = require(rs.Objects.Menu.Menu.SlotBuilder)
        local items = require(rs.Services.Items.ClientItemService)
        local carry = require(rs.Services.Items.CarryService)
        local states = require(rs.Objects.Game.Character.Shared.StateInfo)
        local slots, ids = loadout.GetSlots(), reg.GetAll()
        local cfgs, owned, bytype, bases = {}, {}, {}, {}
        local cos_types = { Cosmetic = true, Character = true, Unusual = true }
        local gear_types = { Consumable = true, Light = true, Utility = true, Power = true }
        local swaps, conns, orig = {}, {}, {}
        local equips, skins = {}, {}
        local rev = 0
        local cache = setmetatable({}, { __mode = "k" })
        local active, refresh_job, save_job, tag
        local dirty = {}
        local batches = setmetatable({}, { __mode = "k" })
        local groups = {}
        local views = setmetatable({}, { __mode = "k" })
        local carries = {}
        local stats = { updates = 0, rigs = 0, emotes = 0, errs = 0 }
        local api = { v = 2, on = true, ready = false }
        local path = "eu_" .. player.UserId .. ".json"
        env.eu = api

        local function report(ctx, err)
            stats.errs += 1
            api.err = ctx:lower()
            api.trace = tostring(err)
        end

        local function guard(ctx, fn, ...)
            local level = type(getthreadidentity) == "function" and getthreadidentity()
            local lower = level and level > 2 and type(setthreadidentity) == "function"
            if lower then
                setthreadidentity(2)
            end
            local result = table.pack(pcall(fn, ...))
            if lower then
                setthreadidentity(level)
            end
            if not result[1] then
                report(ctx, result[2])
            end
            return table.unpack(result, 1, result.n)
        end

        local function hook(module, name, fn)
            local target = module[name]
            assert(type(target) == "function", "no method")
            local prior = hookfunction(target, fn)
            table.insert(swaps, { fn = target, old = prior })
            return prior
        end

        local function connect(signal, fn)
            local conn = signal:Connect(fn)
            table.insert(conns, conn)
            return conn
        end

        local function inview(view, scroll)
            if not view.Parent or not scroll.Parent then
                return false
            end
            local parent = view
            while parent and parent ~= player.PlayerGui do
                if parent:IsA("GuiObject") and not parent.Visible then
                    return false
                end
                if parent:IsA("ScreenGui") and not parent.Enabled then
                    return false
                end
                parent = parent.Parent
            end
            local pos, size = view.AbsolutePosition, view.AbsoluteSize
            local top, area = scroll.AbsolutePosition, scroll.AbsoluteSize
            return size.X > 0
                and size.Y > 0
                and pos.Y + size.Y > top.Y - 150
                and pos.Y < top.Y + area.Y + 150
                and pos.X + size.X > top.X
                and pos.X < top.X + area.X
        end

        local function drop(scroll)
            local group = groups[scroll]
            if not group then
                return
            end
            groups[scroll] = nil
            group.on = false
            if group.job and coroutine.status(group.job) ~= "dead" and group.job ~= coroutine.running() then
                task.cancel(group.job)
            end
            group.busy = false
            for _, conn in group.conns do
                conn:Disconnect()
            end
        end

        local function queue(group)
            group.dirty = true
            if group.busy or not group.on then
                return
            end
            group.busy = true
            group.job = task.defer(function()
                while group.on and group.dirty and api.on do
                    group.dirty = false
                    local built = 0
                    for _, entry in group.entries do
                        if not group.on or not api.on then
                            break
                        end
                        local view = entry.view
                        local visible = inview(view, group.scroll)
                        if visible and not entry.loaded then
                            for _, child in view:GetChildren() do
                                if child:IsA("WorldModel") or child.Name == "Frame" then
                                    child:Destroy()
                                end
                            end
                            local ok = guard("preview", orig.preview, items, entry.mod, view)
                            entry.loaded = ok
                            built += 1
                            if built % 3 == 0 then
                                task.wait()
                            end
                        elseif not visible and entry.loaded then
                            local world = view:FindFirstChildOfClass("WorldModel")
                            if world then
                                world:Destroy()
                            end
                            local frame = view:FindFirstChild("Frame")
                            if frame then
                                frame:Destroy()
                            end
                            view.CurrentCamera = nil
                            entry.loaded = false
                        end
                    end
                end
                group.busy = false
            end)
        end

        local function watchlist(scroll, entries)
            drop(scroll)
            if #entries == 0 then
                return
            end
            local group = { scroll = scroll, entries = entries, on = true, conns = {} }
            groups[scroll] = group
            local function watch(signal, fn)
                table.insert(
                    group.conns,
                    signal:Connect(fn or function()
                        queue(group)
                    end)
                )
            end
            watch(scroll:GetPropertyChangedSignal("CanvasPosition"))
            watch(scroll:GetPropertyChangedSignal("AbsoluteSize"))
            watch(scroll:GetPropertyChangedSignal("AbsolutePosition"))
            watch(scroll.Destroying, function()
                drop(scroll)
            end)
            local parent = scroll
            while parent and parent ~= player.PlayerGui do
                if parent:IsA("GuiObject") then
                    watch(parent:GetPropertyChangedSignal("Visible"))
                end
                parent = parent.Parent
            end
            queue(group)
        end

        local function stackable(cfg)
            return cfg
                and (
                    (cfg.PurchaseInfo and cfg.PurchaseInfo.OwnershipType == "Multiple")
                    or (cfg.ServerInfo and cfg.ServerInfo.Consumable == true)
                    or (cfg.EquipInfo and cfg.EquipInfo.SlotType == "Consumable")
                )
        end

        local function kindof(id)
            local cfg = cfgs[id]
            return cfg and cfg.EquipInfo and cfg.EquipInfo.SlotType
        end

        local function getslot(slot)
            if equips[slot] ~= nil then
                return equips[slot]
            end
            return orig.slot(slot)
        end

        local function getslots()
            local result = table.clone(orig.loadout())
            for slot, id in equips do
                result[slot] = if id > 0 then id else nil
            end
            return result
        end

        local function getskin(base)
            if skins[base] ~= nil then
                return if skins[base] > 0 then skins[base] else nil
            end
            return orig.skin(base)
        end

        local function islocal(data)
            return data.Parent and data.Parent.Local == true
        end

        local function getlist(data, term, source)
            local cached = cache[data]
            if not cached or cached.rev ~= rev then
                cached = { rev = rev }
                cache[data] = cached
            end
            local entry = cached[term]
            if entry and entry.src == source then
                return entry.value
            end
            local result = {}
            if term == "Cosmetics" or term == "Perks" then
                local types = if term == "Cosmetics" then cos_types else { Perk = true }
                local found = false
                for slot in equips do
                    if types[slots[slot]] then
                        found = true
                        break
                    end
                end
                if not found then
                    return source
                end
                local seen = {}
                for slot, id in getslots() do
                    if types[slots[slot]] and id > 0 and not seen[id] then
                        seen[id] = true
                        table.insert(result, id)
                    end
                end
                for _, id in source or {} do
                    if not types[kindof(id)] and not seen[id] then
                        table.insert(result, id)
                    end
                end
            elseif term == "ToolSkins" then
                if next(skins) == nil then
                    return source
                end
                local seen = {}
                for _, id in source or {} do
                    local base = bases[id]
                    if not base or skins[base] == nil then
                        seen[id] = true
                        table.insert(result, id)
                    end
                end
                for _, id in skins do
                    if id > 0 and not seen[id] then
                        table.insert(result, id)
                    end
                end
            end
            table.sort(result)
            cached[term] = { src = source, value = result }
            return result
        end

        local function getdata(data, term)
            local value = orig.get(data, term)
            if not api.on or not islocal(data) then
                return value
            end
            if term == "Emote" and active and active.char == data.Parent then
                return active.id
            end
            if term == "EmoteNum" and active and active.char == data.Parent then
                return active.pick or 1
            end
            if term == "Cosmetics" or term == "Perks" or term == "ToolSkins" then
                return getlist(data, term, value)
            end
            local slot = if term == "CarryItem"
                then "CarryAnimationSlot"
                elseif term == "Nametag" then "NametagSlot"
                elseif term == "Boombox" then "BoomboxSlot"
                else nil
            if slot and equips[slot] ~= nil then
                return equips[slot]
            end
            return value
        end

        local function haschar(char)
            return char
                and char.Done
                and not char.Dead
                and char.Model
                and char.Model.Parent
                and char.Rig
                and char.Rig:GetRigModel()
        end

        local function canplay(char)
            if not haschar(char) then
                return false, "no char"
            end
            if not char.Humanoid or char.Humanoid.Health <= 0 then
                return false, "downed"
            end
            local data = char.DataRegistry
            local state = states:GetState(data:Get("State"))
            if state and state.CanEmote == false then
                return false, "busy"
            end
            for _, term in { "Carrying", "Carried", "Seated" } do
                local value = data:Get(term)
                if value and value ~= 0 then
                    return false, "busy " .. term:lower()
                end
            end
            for _, term in { "Downed", "Dead", "Reviving" } do
                if char.Model:GetAttribute(term) == true then
                    return false, term:lower()
                end
            end
            return true
        end

        local function pose(char)
            if not haschar(char) then
                return
            end
            for _, part in { char.Movement, char.Camera, char.Joints } do
                if part then
                    part:RegistryTermUpdated("Emote")
                end
            end
        end

        function api:stop()
            local current = active
            if not current then
                return true
            end
            active = nil
            if current.conn then
                current.conn:Disconnect()
            end
            if current.job and coroutine.status(current.job) ~= "dead" and current.job ~= coroutine.running() then
                task.cancel(current.job)
            end
            local object = current.obj
            if object then
                object.Active = false
                guard("stop", object.Deactivate, object)
                for _, track in object.Animations or {} do
                    track:Stop(0)
                    track:Destroy()
                end
                table.clear(object.Animations or {})
            end
            local char = current.char
            if char and char.Animations and char.Animations.Emote == object then
                char.Animations.Emote = nil
                if haschar(char) then
                    char.Animations:RegistryTermUpdated("State")
                    guard("pose", pose, char)
                end
            end
            return true
        end

        function api:play(id, pick)
            if not self.on then
                return false, "off"
            end
            if id == nil or id == 0 then
                return self:stop()
            end
            if kindof(id) ~= "Emote" then
                return false, "bad emote"
            end
            if active and active.id == id then
                return self:stop()
            end
            local char = chars:GetLocalCharacter()
            local allowed, reason = canplay(char)
            if not allowed then
                return false, reason
            end
            self:stop()
            if char.Animations.Emote then
                char.Animations.Emote:Deactivate()
                char.Animations.Emote = nil
            end
            local module = ids[id].Module
            local class = require(module:FindFirstChild("EmoteModule") or rs.Objects.Items.Emote)
            local object = class.new(char.Model, module, char.Rig:GetRigModel())
            object:Init(char.Animations)
            local choices = module:FindFirstChild("Selection")
            if choices then
                local children = choices:GetChildren()
                if #children == 0 then
                    return false, "no anim"
                end
                pick = math.clamp(math.floor(tonumber(pick) or 1), 1, #children)
                local chosen = children[pick]
                object.GetSelection = function()
                    return chosen
                end
            end
            local current = { id = id, pick = pick, char = char, obj = object, start = os.clock() }
            active = current
            char.Animations.Emote = object
            local profile = char.ToolProfile
            if profile then
                local weaponless = profile:EquipKeyToIndex("Weaponless")
                if weaponless then
                    profile:Equip(weaponless)
                end
            end
            pose(char)
            stats.emotes += 1
            current.job = task.defer(function()
                local ok = guard("emote " .. id, object.Activate, object, false)
                if not ok and active == current then
                    self:stop()
                    return
                end
                if active == current then
                    current.loaded = os.clock()
                end
            end)
            current.conn = run.Heartbeat:Connect(function()
                if active ~= current then
                    return
                end
                if not canplay(char) or object.Active == false or char.Rig:GetRigModel() ~= object.Rig then
                    self:stop()
                    return
                end
                local track = object.Animations and object.Animations.Animation

                if (not current.loaded or not track) and os.clock() - current.start > 15 then
                    report("emote " .. id, "timeout")
                    self:stop()
                    return
                end
                local length = object.EmoteInfo and object.EmoteInfo.Length
                if current.loaded and type(length) == "number" and length > 0 and os.clock() - current.loaded >= length then
                    self:stop()
                end
            end)
            return true
        end

        local function wheel(popup)
            popup = popup or pops:GetPopup("Emote")
            if not popup or not popup.Frame or not popup.Frame.Parent then
                return
            end
            local list = {}
            for index = 1, 12 do
                local id = getslot("EmoteSlot_" .. index)
                if id > 0 and kindof(id) == "Emote" then
                    list[index] = id
                end
            end
            local same = popup.Emotes ~= nil
            for index = 1, 12 do
                if not popup.Emotes or popup.Emotes[index] ~= list[index] then
                    same = false
                    break
                end
            end
            if not same then
                orig.wheel(popup, list)
            end
        end

        local function untag()
            if not tag then
                return
            end
            tag.handler:Destroy()
            tag.gui:Destroy()
            tag = nil
        end

        local function settag(char)
            local id = equips.NametagSlot
            local rig = char and char.Rig and char.Rig:GetRigModel()
            local head = rig and rig:FindFirstChild("Head")
            if tag and tag.id == id and tag.head == head then
                return
            end
            untag()
            if not api.on or not id or id == 0 or not head then
                return
            end
            local tags = require(rs.Shared.Misc.TagHandler)
            local handler = tags.new({
                InitialBind = true,
                GlobalTransparency = false,
                InitialInstancesEnabled = true,
                Module = ids[id].Module,
                ScaleType = tags.ScaleTypes.XY,
                ZIndexMode = tags.ZIndexModes.Sibling,
            })
            local gui = Instance.new("BillboardGui")
            gui.Name = "eu_tag"
            gui.Size = UDim2.fromOffset(220, 42)
            gui.StudsOffset = Vector3.new(0, 2.2, 0)
            gui.AlwaysOnTop = false
            gui.MaxDistance = 100
            gui.Adornee = head
            tag = { id = id, head = head, handler = handler, gui = gui }
            handler:Initialize()
            handler:SetText(player.DisplayName)
            handler.Frame.Size = UDim2.fromScale(1, 1)
            handler.Frame.Parent = gui
            gui.Parent = head
        end

        local function sameids(a, b)
            if a == b then
                return true
            end
            if not a or not b or #a ~= #b then
                return false
            end
            for _, value in a do
                if not table.find(b, value) then
                    return false
                end
            end
            return true
        end

        local function dress(changes)
            local char = chars:GetLocalCharacter()
            if not haschar(char) then
                untag()
                return
            end
            local data, rig = char.DataRegistry, char.Rig
            local cosmetics, boombox, tool_skins =
                data:Get("Cosmetics") or {}, data:Get("Boombox") or 0, data:Get("ToolSkins") or {}
            local built = rig:GetRig()
            rig.ToolSkins = tool_skins
            local gear = rig:GetGear()
            local rebuild = changes.rig
                and (not sameids(built.Cosmetics, cosmetics) or built.Boombox ~= boombox or not sameids(built.Gear or {}, gear))
            if rebuild then
                api:stop()
                if char.Animations.Carry then
                    char.Animations.Carry:Deactivate()
                    char.Animations.Carry = nil
                end
                rig.Cosmetics, rig.Boombox, rig.ToolSkins = cosmetics, boombox, tool_skins
                rig.Built = false
                rig:BuildRig()
                char.Animations:SetAnimationType(data:Get("AnimationType") or "Default")
                char.Animations:RegistryTermUpdated("State")
                stats.rigs += 1
            end
            if changes.skin or rebuild then
                local profile = char.ToolProfile
                if rebuild and profile and profile.CharacterVisuals then
                    profile.CharacterVisuals.Rig = rig:GetRig()
                end
                local tool = profile and profile:GetCurrentTool()
                if tool then
                    if profile.CharacterVisuals then
                        profile.CharacterVisuals:SetTool(tool)
                    end
                    if profile.ViewmodelVisuals then
                        profile.ViewmodelVisuals:SetTool(tool)
                    end
                end
            end
            if changes.carry or rebuild then
                local carrying = data:Get("Carrying")
                if carrying and carrying ~= 0 then
                    char.Animations:RegistryTermUpdated("Carrying")
                elseif data:Get("Carried") and data:Get("Carried") ~= 0 then
                    char.Animations:RegistryTermUpdated("Carried")
                end
            end
            if changes.perk and char.Movement then
                char.Movement:RegistryTermUpdated("Perks")
            end
            if changes.tag or rebuild then
                char.Rig:RegistryTermUpdated("Nametag")
                settag(char)
            end
        end

        local function refresh(kind)
            dirty[kind or "wheel"] = true
            if refresh_job then
                return
            end
            refresh_job = task.defer(function()
                refresh_job = nil
                if not api.on then
                    return
                end
                local changes = dirty
                dirty = {}
                stats.updates += 1
                if changes.wheel then
                    guard("wheel", wheel)
                end
                if changes.rig or changes.skin or changes.carry or changes.perk or changes.tag then
                    guard("rig", dress, changes)
                end
            end)
        end

        local function refreshall()
            for _, kind in { "rig", "skin", "carry", "perk", "tag", "wheel" } do
                refresh(kind)
            end
        end

        function api:export()
            local skin_ids = {}
            for base, id in skins do
                skin_ids[tostring(base)] = id
            end
            return { v = 1, slots = table.clone(equips), skins = skin_ids }
        end

        local function save()
            if type(writefile) ~= "function" then
                return
            end
            guard("save", function()
                writefile(path, http:JSONEncode(api:export()))
            end)
        end

        local function changed(slot)
            rev += 1
            loadout.Changed:Fire()
            local kind = slots[slot]
            if kind == "Emote" then
                refresh("wheel")
            elseif cos_types[kind] or kind == "Boombox" then
                refresh("rig")
            elseif kind == "CarryAnimation" then
                refresh("carry")
            elseif kind == "Nametag" then
                refresh("tag")
            elseif kind == "Perk" then
                refresh("perk")
            end
            if save_job then
                task.cancel(save_job)
            end
            save_job = task.delay(0.3, function()
                save_job = nil
                if api.on then
                    save()
                end
            end)
        end

        function api:equip(slot, id)
            if not self.on then
                return false, "off"
            end
            if type(slot) ~= "string" or slots[slot] == nil then
                return false, "bad slot"
            end
            if id == nil then
                id = 0
            end
            if type(id) ~= "number" or id < 0 or id % 1 ~= 0 then
                return false, "bad id"
            end
            if id > 0 and kindof(id) ~= slots[slot] then
                return false, "wrong slot"
            end
            local kind = slots[slot]
            if kind == "Consumable" then
                if id > 0 and not inv.HasConsumable(id) then
                    return false, "empty"
                end
                orig.equip(slot, if id > 0 then id else nil)
                return true, "sent"
            end
            if gear_types[kind] and (id == 0 or orig.owns(id)) then
                equips[slot] = nil
                orig.equip(slot, if id > 0 then id else nil)
                changed(slot)
                return true, "sent"
            end
            if getslot(slot) == id and equips[slot] ~= nil then
                return true
            end
            if id > 0 then
                for other, equipped in getslots() do
                    if other ~= slot and equipped == id then
                        equips[other] = 0
                    end
                end
            end
            equips[slot] = id
            changed(slot)
            return true, "equipped"
        end

        function api:unequip(slot)
            return self:equip(slot, 0)
        end

        function api:skin(base, id)
            if not self.on then
                return false, "off"
            end
            if not ids[base] then
                return false, "bad item"
            end
            id = id or 0
            if id ~= 0 and bases[id] ~= base then
                return false, "wrong skin"
            end
            skins[base] = id
            rev += 1
            inv.Changed:Fire()
            refresh("rig")
            refresh("skin")
            save()
            return true
        end

        function api:reset()
            self:stop()
            table.clear(equips)
            table.clear(skins)
            rev += 1
            inv.Changed:Fire()
            loadout.Changed:Fire()
            refreshall()
            save()
        end

        function api:status()
            return {
                v = self.v,
                on = self.on,
                ready = self.ready,
                items = #owned,
                loadout = getslots(),
                slots = table.clone(equips),
                emote = active and active.id,
                stats = table.clone(stats),
                err = self.err,
            }
        end

        function api:refresh()
            if not self.on then
                return false, "off"
            end
            rev += 1
            wheel()
            dress({ rig = true, skin = true, carry = true, perk = true, tag = true })
            return true
        end

        function api:unload()
            if not self.on then
                return true
            end
            self:stop()
            for object in carries do
                guard("carry", object.Deactivate, object)
            end
            self.on = false
            for scroll, group in groups do
                drop(scroll)
                for _, entry in group.entries do
                    if entry.view:IsDescendantOf(player.PlayerGui) and not entry.loaded then
                        guard("preview", orig.preview, items, entry.mod, entry.view)
                    end
                end
            end
            if refresh_job then
                task.cancel(refresh_job)
                refresh_job = nil
            end
            if save_job then
                task.cancel(save_job)
                save_job = nil
                save()
            end
            for _, conn in conns do
                conn:Disconnect()
            end
            table.clear(conns)
            untag()
            for index = #swaps, 1, -1 do
                local entry = swaps[index]
                guard("hook", hookfunction, entry.fn, entry.old)
            end
            table.clear(swaps)
            for view, values in views do
                view.MoreEmotes, view.OwnsRelics = values[1], values[2]
            end
            if orig.loadout then
                guard("rig", dress, { rig = true, skin = true, carry = true, perk = true, tag = true })
                for index = 1, 12 do
                    equips["EmoteSlot_" .. index] = nil
                end
                if orig.wheel then
                    guard("wheel", wheel)
                end
                inv.Changed:Fire()
                loadout.Changed:Fire()
            end
            if env.eu == self then
                env.eu = nil
            end
            return true
        end

        local function boot()
            local budget = os.clock()
            for id, item in ids do
                local cfg = reg.GetConfig(id)
                if type(cfg) ~= "table" then
                    local ok, value = guard("item " .. id, require, item.Module)
                    if ok then
                        cfg = value
                    end
                end
                if type(cfg) == "table" then
                    cfgs[id] = cfg
                    local base = item.Module:FindFirstChild("Original")
                    if base and base:IsA("ObjectValue") and base.Value then
                        bases[id] = base.Value:GetAttribute("ID")
                    end
                    if not stackable(cfg) then
                        table.insert(owned, id)
                        local kind = kindof(id)
                        if kind then
                            bytype[kind] = bytype[kind] or {}
                            table.insert(bytype[kind], id)
                        end
                    end
                end
                if os.clock() - budget > 0.008 then
                    task.wait()
                    budget = os.clock()
                end
            end
            table.sort(owned)
            assert(#owned > 0, "no items")
            for _, list in bytype do
                table.sort(list)
            end
            if not saved and type(isfile) == "function" and type(readfile) == "function" then
                local ok, result = guard("save", function()
                    local file = path
                    if not isfile(file) then
                        file = "EvadeUnlock_" .. player.UserId .. ".json"
                    end
                    if isfile(file) then
                        return http:JSONDecode(readfile(file))
                    end
                end)
                if ok then
                    saved = result
                end
            end
            if type(saved) == "table" then
                saved = { v = saved.v or saved.Version, slots = saved.slots or saved.Slots, skins = saved.skins or saved.Skins }
            end
            if type(saved) == "table" and saved.v == 1 then
                for slot, id in if type(saved.slots) == "table" then saved.slots else {} do
                    if
                        slots[slot]
                        and slots[slot] ~= "Consumable"
                        and type(id) == "number"
                        and (id == 0 or kindof(id) == slots[slot])
                    then
                        equips[slot] = id
                    end
                end
                for base, id in if type(saved.skins) == "table" then saved.skins else {} do
                    base = tonumber(base)
                    if base and ids[base] and (id == 0 or bases[id] == base) then
                        skins[base] = id
                    end
                end
            end
            orig.config = hook(reg, "GetConfig", function(id)
                return cfgs[id] or orig.config(id)
            end)
            orig.preview = hook(items, "CreateViewport", function(self, module, view)
                local entries = batches[coroutine.running()]
                if entries then
                    table.insert(entries, { mod = module, view = view })
                    return
                end
                return orig.preview(self, module, view)
            end)
            orig.slots = hook(builder, "SetupSlots", function(self, scroll, ...)
                local thread, entries = coroutine.running(), {}
                batches[thread] = entries
                local result = table.pack(pcall(orig.slots, self, scroll, ...))
                batches[thread] = nil
                if not result[1] then
                    error(result[2], 0)
                end
                local scrollbox = if scroll:IsA("ScrollingFrame")
                    then scroll
                    else scroll:FindFirstAncestorOfClass("ScrollingFrame")
                if scrollbox then
                    watchlist(scrollbox, entries)
                else
                    for _, entry in entries do
                        orig.preview(items, entry.mod, entry.view)
                    end
                end
                return table.unpack(result, 2, result.n)
            end)
            orig.filter = hook(builder, "FilterSlots", function(self, ...)
                local result = orig.filter(self, ...)
                for _, group in groups do
                    queue(group)
                end
                return result
            end)
            orig.owns = hook(inv, "Owns", function(id)
                if cfgs[id] and not stackable(cfgs[id]) then
                    return true
                end
                return orig.owns(id)
            end)
            orig.ids = hook(inv, "OwnedIds", function()
                local result, seen = table.clone(owned), {}
                for _, id in result do
                    seen[id] = true
                end
                for _, id in orig.ids() do
                    if not seen[id] then
                        table.insert(result, id)
                    end
                end
                table.sort(result)
                return result
            end)
            orig.bytype = hook(inv, "GetOwnedBySlotType", function(kind)
                local result, seen = table.clone(bytype[kind] or {}), {}
                for _, id in result do
                    seen[id] = true
                end
                for _, id in orig.bytype(kind) do
                    if not seen[id] then
                        table.insert(result, id)
                    end
                end
                table.sort(result)
                return result
            end)
            orig.slot = hook(loadout, "GetEquippedFromSlot", getslot)
            orig.loadout = hook(loadout, "GetEquipped", function()
                return table.freeze(getslots())
            end)
            orig.equipped = hook(loadout, "IsEquipped", function(id)
                for slot, equipped in getslots() do
                    if id == equipped then
                        return true, slot
                    end
                end
                return false, nil
            end)
            orig.available = hook(loadout, "IsSlotAvailable", function(slot)
                return slots[slot] ~= nil
            end)
            orig.equip = hook(loadout, "TryEquip", function(slot, id)
                return api:equip(slot, id)
            end)
            orig.unequip = hook(loadout, "TryUnequip", function(slot)
                return api:unequip(slot)
            end)
            orig.skin = hook(inv, "GetSkin", getskin)
            orig.mod = hook(inv, "ItemMod", function(base, key)
                if key == "Skin" and skins[base] ~= nil then
                    return getskin(base)
                end
                return orig.mod(base, key)
            end)
            orig.mods = hook(inv, "ItemMods", function(base)
                local result = table.clone(orig.mods(base))
                if skins[base] ~= nil then
                    result.Skin = getskin(base)
                end
                return result
            end)
            orig.setskin = hook(inv, "TrySetSkin", function(base, id)
                return api:skin(base, id)
            end)
            orig.get = hook(data_cls, "Get", getdata)
            orig.set = hook(data_cls, "SetTerm", function(data, term, value)
                local before = data.Data[term]
                local result = orig.set(data, term, value)
                if islocal(data) and before ~= value then
                    if term == "Cosmetics" or term == "Perks" or term == "ToolSkins" then
                        cache[data] = nil
                    end
                    if term == "Cosmetics" or term == "Boombox" or term == "ToolSkins" then
                        refresh("rig")
                    end
                    if term == "Nametag" then
                        refresh("tag")
                    end
                    if
                        active
                        and active.char == data.Parent
                        and (term == "State" or term == "Carried" or term == "Carrying" or term == "Seated")
                    then
                        if not canplay(data.Parent) then
                            api:stop()
                        end
                    end
                end
                return result
            end)
            orig.anim = hook(anims, "RegistryTermUpdated", function(anim, term)
                if term == "Emote" and active and anim.Parent == active.char then
                    return
                end
                return orig.anim(anim, term)
            end)
            orig.carry = hook(carry, "SetCarry", function(self, model, module, preview, anim, target, rig)
                if not anim or not anim.Parent or not anim.Parent.Local then
                    return orig.carry(self, model, module, preview, anim, target, rig)
                end
                local class = require(module:FindFirstChild("CarryModule") or rs.Objects.Items.Carry)
                local object = class.new(model, module, rig)
                object:Init(anim)

                local copy
                for _, joint in module:GetDescendants() do
                    if (joint:IsA("Motor6D") or joint:IsA("Weld")) and (not joint.Part0 or not joint.Part1) then
                        copy = module:Clone()
                        for _, item in copy:GetDescendants() do
                            if (item:IsA("Motor6D") or item:IsA("Weld")) and (not item.Part0 or not item.Part1) then
                                item:Destroy()
                            end
                        end
                        object.CarryModule = copy
                        break
                    end
                end
                local deactivate = object.Deactivate
                object.Deactivate = function(current, ...)
                    if not carries[current] then
                        return
                    end
                    carries[current] = nil
                    local ok, err = pcall(deactivate, current, ...)
                    for _, track in current.Animations or {} do
                        track:Stop(0)
                        track:Destroy()
                    end
                    table.clear(current.Animations or {})
                    if copy then
                        copy:Destroy()
                        copy = nil
                    end
                    if not ok then
                        error(err, 0)
                    end
                end
                carries[object] = true
                local ok = guard(
                    "carry " .. module.Name,
                    object.Activate,
                    object,
                    preview,
                    if target == nil then "Carried" else "Carry",
                    target
                )
                if not ok then
                    guard("carry", object.Deactivate, object)
                    return nil
                end
                return object
            end)
            orig.char_new = hook(charcls, "Init", function(char, ...)
                local result = orig.char_new(char, ...)
                if char.Local then
                    refreshall()
                end
                return result
            end)
            orig.char_del = hook(charcls, "Destroy", function(char, ...)
                if char.Local then
                    api:stop()
                    untag()
                end
                return orig.char_del(char, ...)
            end)
            orig.wheel = hook(emotes, "SetEquipped", function(popup)
                wheel(popup)
            end)
            orig.show = hook(emotes, "Show", function(popup)
                wheel(popup)
                return orig.show(popup)
            end)
            orig.canplay = hook(emotes, "CanActivate", function(popup, selecting)
                if active then
                    if not selecting then
                        api:stop()
                        return false
                    end
                    return canplay(chars:GetLocalCharacter())
                end
                return orig.canplay(popup, selecting)
            end)
            orig.key = hook(emotes, "KeyActivated", function(popup, index)
                if type(index) ~= "number" or index < 1 or index > 12 or index % 1 ~= 0 then
                    return
                end
                local id = getslot("EmoteSlot_" .. index)
                if id > 0 then
                    local ok, reason = api:play(id)
                    if not ok then
                        report("emote", reason)
                    end
                end
                popup.LastActivated = tick()
                popup.Active = false
                pops:UpdateVisibility()
            end)
            orig.header = hook(slotcls, "SetHeader", function(view, ...)
                if not views[view] then
                    views[view] = { view.MoreEmotes, view.OwnsRelics }
                end
                view.MoreEmotes, view.OwnsRelics = true, true
                return orig.header(view, ...)
            end)
            connect(loadout.Changed, function()
                rev += 1
                refresh("wheel")
            end)
            connect(inv.Changed, function()
                rev += 1
            end)
            connect(player.CharacterRemoving, function()
                api:stop()
                untag()
            end)
            api.ready = true
            guard("items", function()
                inv.Changed:Fire()
                loadout.Changed:Fire()
            end)
            refreshall()
        end

        for _, name in { "equip", "unequip", "skin", "play", "stop", "reset", "refresh", "unload" } do
            local method = api[name]
            api[name] = function(self, ...)
                local result = table.pack(guard(name, method, self, ...))
                if not result[1] then
                    if name ~= "stop" then
                        self:stop()
                    end
                    return false, self.err
                end
                return table.unpack(result, 2, result.n)
            end
        end

        local ok = guard("load", boot)
        if not ok then
            api:unload()
        end
end
function UnlockAllStop()
local eu = getgenv().eu
if eu and eu.unload then pcall(function() eu:unload() end) end
end
