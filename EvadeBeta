local function applyFrontalJump()
local char = LocalPlayer.Character
if not char then return end
local root = char:FindFirstChild("HumanoidRootPart")
local humanoid = char:FindFirstChild("Humanoid")
if not root or not humanoid then return end
local bv = root:FindFirstChild("FrontalJumpBV")
if not EnableFrontalJump then
if bv then bv:Destroy() end
return
end
local isAir = humanoid.FloorMaterial == Enum.Material.Air
if isAir then
local lookDir = workspace.CurrentCamera.CFrame.LookVector
lookDir = Vector3.new(lookDir.X, 0, lookDir.Z)
if lookDir.Magnitude > 0 then lookDir = lookDir.Unit end
if not bv then
bv = Instance.new("BodyVelocity")
bv.Name = "FrontalJumpBV"
bv.MaxForce = Vector3.new(4e5, 0, 4e5)
bv.P = 1250
bv.Parent = root
end
bv.Velocity = lookDir * FrontalJumpSpeed
else
if bv then bv:Destroy() end
end
end
local function applyBackJump()
local char = LocalPlayer.Character
if not char then return end
local root = char:FindFirstChild("HumanoidRootPart")
local humanoid = char:FindFirstChild("Humanoid")
if not root or not humanoid then return end
local bv = root:FindFirstChild("BackJumpBV")
if not EnableBackJump then
if bv then bv:Destroy() end
return
end
local isAir = humanoid.FloorMaterial == Enum.Material.Air
if isAir then
local lookDir = workspace.CurrentCamera.CFrame.LookVector
local backDir = Vector3.new(-lookDir.X, 0, -lookDir.Z)
if backDir.Magnitude > 0 then backDir = backDir.Unit end
if not bv then
bv = Instance.new("BodyVelocity")
bv.Name = "BackJumpBV"
bv.MaxForce = Vector3.new(4e5, 0, 4e5)
bv.P = 1250
bv.Parent = root
end
bv.Velocity = backDir * BackJumpSpeed
else
if bv then bv:Destroy() end
end
end
