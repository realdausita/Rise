function loadCachedFile(path)
if isfile and readfile then
local ok, content = pcall(isfile, path)
if ok and content then
local readOk, data = pcall(readfile, path)
if readOk and data and #data > 1000 then
return data
end
end
end
return nil
end
function saveCachedFile(path, content)
pcall(function()
if writefile and makefolder and isfolder then
if not isfolder("RiseHub") then makefolder("RiseHub") end
if not isfolder("RiseHub/Cache") then makefolder("RiseHub/Cache") end
writefile(path, content)
end
end)
end
