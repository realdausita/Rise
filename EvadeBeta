_KB.rsl = function(t)
t = t or "Item"
if type(t) ~= "string" then return "Item" end
if t:sub(1, 4) == "loc:" then
_KB.rk = t:sub(5)
if _LANG == "Türkçe" and _KB.tr and _KB.tr[_KB.rk] then return _KB.tr[_KB.rk] end
if _KB.en[_KB.rk] then return _KB.en[_KB.rk] end
end
return t
end
_KB.want = function(cfg)
if type(cfg) ~= "table" then return false end
_KB.t = cfg.Title or "Item"
if type(_KB.t) ~= "string" then return false end
if _KB.skip[_KB.t] then return false end
if _KB.t:find("Keybind") then return false end
return true
end
_KB.preT = function(cfg)
_KB.cbmap[cfg] = cfg.Callback
_KB.st[cfg] = cfg.Value or false
cfg.Callback = function(s)
_KB.st[cfg] = s
_KB.f = _KB.cbmap[cfg]
if _KB.f then return _KB.f(s) end
end
end
_KB.mkT = function(box, el, cfg)
if not el then return end
pcall(function()
_KB.kb = box:Keybind({Title = _KB.rsl(cfg.Title) .. " Keybind", Value = "NONE", Callback = function()
pcall(function() el:Set(not _KB.st[cfg]) end)
end})
_KB.rows = _KB.rows or {}
table.insert(_KB.rows, {el = _KB.kb, base = cfg.Title})
end)
end
_KB.refreshRows = function()
if not _KB.rows then return end
for _, r in ipairs(_KB.rows) do
if r.el and r.el.SetTitle then
pcall(function() r.el:SetTitle(_KB.rsl(r.base) .. " Keybind") end)
end
end
end
_KB.mkB = function(box, el, cfg)
if not el then return end
_KB.cbmap[el] = cfg.Callback
pcall(function()
_KB.kb = box:Keybind({Title = _KB.rsl(cfg.Title) .. " Keybind", Value = "NONE", Callback = function()
_KB.f = _KB.cbmap[el]
if _KB.f then pcall(_KB.f) end
end})
_KB.rows = _KB.rows or {}
table.insert(_KB.rows, {el = _KB.kb, base = cfg.Title})
_KB.dmap = _KB.dmap or {}
_KB.dmap[el] = {kb = _KB.kb, od = el.Destroy}
el.Destroy = function(self, ...)
