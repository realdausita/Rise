table.insert(vehicleTargets, { model = model, name = model.Name })
end
end
end
local _dbgT5 = os.clock()
updateGenericESP(vehicleTargets, Color3.fromRGB(255, 105, 180), ESPManager.VehicleSettings, ESPManager.VehicleElements)
_dbgCat("vehicle", _dbgT5)
local _dbgMs = (os.clock() - _dbgT0) * 1000
ESPManager.Dbg.ms = _dbgMs
ESPManager.Dbg.cycles = ESPManager.Dbg.cycles + 1
ESPManager.Dbg.newBB = 4 - (ESPManager.BudgetBB or 0)
ESPManager.Dbg.newBox = 4 - (ESPManager.BudgetBox or 0)
if _dbgMs > ESPManager.Dbg.maxMs then
ESPManager.Dbg.maxMs = _dbgMs
ESPManager.Dbg.maxAt = ESPManager.UpdateCounter
end
getgenv().RiseESP_Dbg = ESPManager.Dbg
end
function onRenderStepped()
ESPManager.LastRenderTime = tick()
ESPManager.Rendering = true
updateESP()
pcall(updateTracers)
end
function StartESP()
StopESP()
if _ESPNeedSweep then
_ESPNeedSweep = false
task.spawn(function()
pcall(function()
for _, d in ipairs(workspace:GetDescendants()) do
if d.Name == "ESP_Billboard" or d.Name == "ESP_2DBox" or d.Name == "ESP_3DBox" then
pcall(function() d:Destroy() end)
end
end
end)
end)
end
ESPManager.Enabled = true
ESPManager.Connections.Render = RunService.RenderStepped:Connect(onRenderStepped)
end
function StopESP()
ESPManager.Enabled = false
if ESPManager.Connections.Render then
ESPManager.Connections.Render:Disconnect()
ESPManager.Connections.Render = nil
end
cleanupESP()
end
getgenv().RiseESP_Cleanup = function()
pcall(function()
if ESPManager.Connections.Render then
ESPManager.Connections.Render:Disconnect()
ESPManager.Connections.Render = nil
end
end)
pcall(cleanupESP)
pcall(function()
for _, d in ipairs(workspace:GetDescendants()) do
if d.Name == "ESP_Billboard" or d.Name == "ESP_2DBox" or d.Name == "ESP_3DBox" then
pcall(function() d:Destroy() end)
end
end
end)
end
RunService.RenderStepped:Connect(function()
ESPManager.LastRenderTime = tick()
ESPManager.Rendering = true
end)
local renderCheckConn = RunService.Heartbeat:Connect(function()
local currentTime = tick()
if currentTime - ESPManager.LastRenderTime > 2.5 then
ESPManager.Rendering = false
cleanupESP()
end
end)
UserInputService.WindowFocusReleased:Connect(function()
end)
UserInputService.WindowFocused:Connect(function()
ESPManager.WindowFocused = true
ESPManager.Rendering = true
end)
game:GetService("GuiService"):GetPropertyChangedSignal("MenuIsOpen"):Connect(function()
if game:GetService("GuiService").MenuIsOpen then
ESPManager.Rendering = false
cleanupESP()
else
ESPManager.Rendering = true
end
end)
