_SHD_safe = function(n)
n = tostring(n or ""):gsub("[^%w%-%_ ]", ""):gsub("%s+", "_"):sub(1, 32)
if n == "" then n = "Custom" end
return n
end
_SHD_loadSaved = function()
local files = {}
pcall(function()
if isfolder(_SHD_DIR) then files = listfiles(_SHD_DIR) end
end)
local count = 0
local http = game:GetService("HttpService")
for _, f in ipairs(files) do
if type(f) == "string" and f:lower():sub(-5) == ".json" then
local ok, content = pcall(readfile, f)
if ok and type(content) == "string" and content ~= "" then
local ok2, data = pcall(function() return http:JSONDecode(content) end)
if ok2 and type(data) == "table" and type(data.preset) == "table" then
local nm = type(data.name) == "string" and data.name ~= "" and data.name or f:match("([^/\\]+)%.json$")
if nm and not _SHD_BUILTIN[nm] then
data.preset._file = f
_SHD_PRESETS[nm] = data.preset
local has = false
for _, v in ipairs(_SHD_ORDER) do if v == nm then has = true break end end
if not has then table.insert(_SHD_ORDER, nm) end
count = count + 1
end
end
end
end
end
return count
end
