function getObjectives()
local objectives = {}
local gameFolder = workspace:FindFirstChild("Game")
if not gameFolder then return objectives end
local mapFolder = gameFolder:FindFirstChild("Map")
if not mapFolder then return objectives end
local partsFolder = mapFolder:FindFirstChild("Parts")
if not partsFolder then return objectives end
local objectivesFolder = partsFolder:FindFirstChild("Objectives")
if not objectivesFolder then return objectives end
for _, obj in pairs(objectivesFolder:GetChildren()) do
if obj:IsA("Model") then
local primaryPart = obj.PrimaryPart
if not primaryPart then
for _, part in pairs(obj:GetChildren()) do
if part:IsA("BasePart") then
primaryPart = part
