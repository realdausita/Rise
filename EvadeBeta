-- Rise open-button preference: independent of the gameplay config/Auto Save.
do
    local window = Window
    local ui = WindUI
    local inputService = SVC.UserInputService
    local http = SVC.HttpService
    local tweenService = SVC.TweenService
    local env = getgenv()
    local previous = env.__RiseOpenButtonController
    if previous and type(previous.Destroy) == "function" then
        pcall(function() previous:Destroy() end)
    end

    local controller = { Style = "Rise Animated", Connections = {}, Destroyed = false }
    local savePath = "RiseHub/OpenButton.json"
    local gui, button, spin
    local activeInput, dragStart, startPosition
    local moved = false
    local nextToggle = 0
    local warned = false
    local savedPosition

    local function validNumber(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end

    if type(readfile) == "function" then
        local ok, data = pcall(function()
            if type(isfile) == "function" and not isfile(savePath) then return nil end
            return http:JSONDecode(readfile(savePath))
        end)
        if ok and type(data) == "table" then
            if data.style == "Default" or data.style == "Rise Animated" then
                controller.Style = data.style
            end
            local p = data.position
            if type(p) == "table" and validNumber(p.x) and validNumber(p.y) then
                savedPosition = Vector2.new(math.clamp(p.x, 0, 1), math.clamp(p.y, 0, 1))
            end
        end
    end

    local function connect(signal, callback)
        local connection = signal:Connect(callback)
        table.insert(controller.Connections, connection)
        return connection
    end

    local function savePreference()
        local ok, err = pcall(function()
            assert(type(writefile) == "function", "writefile is unavailable")
            if type(makefolder) == "function" then
                if type(isfolder) ~= "function" or not isfolder("RiseHub") then
                    pcall(makefolder, "RiseHub")
                end
            end
            writefile(savePath, http:JSONEncode({
                version = 1,
                style = controller.Style,
                position = savedPosition and { x = savedPosition.X, y = savedPosition.Y } or nil,
            }))
        end)
        if not ok and not warned then
            warned = true
            warn("[Rise Open Button] Save failed: " .. tostring(err))
            pcall(function()
                ui:Notify({
                    Title = "Open Button",
                    Content = _T("Selection works for this session, but could not be saved to disk.",
                        "Secim bu oturumda uygulandi, ancak dosyaya kaydedilemedi."),
                    Duration = 5,
                })
            end)
        end
        return ok
    end

    function controller:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        activeInput = nil
        for _, connection in ipairs(self.Connections) do connection:Disconnect() end
        table.clear(self.Connections)
        if spin then spin:Cancel() end
        if gui then gui:Destroy() end
        if env.__RiseOpenButtonController == self then env.__RiseOpenButtonController = nil end
    end

    gui = Instance.new("ScreenGui")
    gui.Name = "RiseAnimatedOpenButton"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 100
    gui.Enabled = false
    -- Use the same verified GUI parent as WindUI, without scanning unrelated UI.
    gui.Parent = ui.ScreenGui.Parent

    local surface = Instance.new("Frame")
    surface.Name = "DragSurface"
    surface.Size = UDim2.fromScale(1, 1)
    surface.BackgroundTransparency = 1
    surface.Parent = gui

    button = Instance.new("TextButton")
    button.Name = "Buttons"
    button.Size = UDim2.fromOffset(53, 50)
    button.Position = UDim2.fromScale(0.15556, 0.21598)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.AutoButtonColor = false
    button.ZIndex = 9
    button.Parent = surface

    local wind = Instance.new("ImageLabel")
    wind.Name = "wind"
    wind.BackgroundTransparency = 1
    wind.Image = "rbxassetid://103191424920623"
    wind.Size = UDim2.fromOffset(130, 136)
    wind.Position = UDim2.new(-0.73493, 0, -0.86981, 0)
    wind.Rotation = 180
    wind.ZIndex = 9
    wind.Parent = button

    local rise = Instance.new("ImageLabel")
    rise.Name = "rise"
    rise.BackgroundTransparency = 1
    rise.Image = "rbxassetid://117889490786317"
    rise.Size = UDim2.fromOffset(47, 51)
    rise.Position = UDim2.new(0.0748, 0, -0.00378, 0)
    rise.ZIndex = 10
    rise.Parent = button

    -- A full 360-degree loop, with no jump between repetitions.
    spin = tweenService:Create(wind,
        TweenInfo.new(10, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Rotation = 540 })

    local function placeButton(x, y)
        local size = surface.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then return end
        x = math.clamp(x, 0, math.max(0, size.X - 53))
        y = math.clamp(y, 0, math.max(0, size.Y - 50))
        button.Position = UDim2.fromOffset(x, y)
        savedPosition = Vector2.new(x / size.X, y / size.Y)
    end

    local function restorePosition()
        local size = surface.AbsoluteSize
        local p = savedPosition or Vector2.new(0.15556, 0.21598)
        placeButton(p.X * size.X, p.Y * size.Y)
    end

    function controller:SetStyle(style, persist)
        if self.Destroyed then return end
        if type(style) == "table" then style = style[1] end
        if style ~= "Default" and style ~= "Rise Animated" then return end
        self.Style = style
        activeInput = nil
        local animated = style == "Rise Animated"
        -- This fork's EditOpenButton(Enabled=true) does not restore this flag.
        window.IsOpenButtonEnabled = not animated
        window.OpenButtonMain:Visible(not animated and window.Closed == true)
        gui.Enabled = animated
        if animated then spin:Play() else spin:Pause() end
        if persist then savePreference() end
    end

    local function updateDrag(input)
        local delta = input.Position - dragStart
        if delta.Magnitude > 6 then moved = true end
        if moved then placeButton(startPosition.X + delta.X, startPosition.Y + delta.Y) end
    end

    connect(button.InputBegan, function(input)
        if activeInput or not gui.Enabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        activeInput = input
        dragStart = input.Position
        startPosition = button.AbsolutePosition - surface.AbsolutePosition
        moved = false
    end)

    connect(inputService.InputChanged, function(input)
        if not activeInput then return end
        if input == activeInput or (activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateDrag(input)
        end
    end)

    -- Global release also handles dragging outside the button's original bounds.
    connect(inputService.InputEnded, function(input)
        if not activeInput or input ~= activeInput then return end
        updateDrag(input)
        activeInput = nil
        if moved then
            savePreference()
            return
        end
        local position = input.Position
        local origin = button.AbsolutePosition
        local size = button.AbsoluteSize
        if position.X < origin.X or position.Y < origin.Y
            or position.X > origin.X + size.X or position.Y > origin.Y + size.Y then return end
        if controller.Destroyed or window.Destroyed or os.clock() < nextToggle then return end
        nextToggle = os.clock() + 0.55
        -- Keep keyboard, close icon, blur and internal Closed state in sync.
        window:Toggle()
    end)

    connect(inputService.WindowFocusReleased, function() activeInput = nil end)
    connect(surface:GetPropertyChangedSignal("AbsoluteSize"), function()
        activeInput = nil
        restorePosition()
    end)
    connect(ui.ScreenGui.Destroying, function() controller:Destroy() end)
    connect(gui.Destroying, function()
        if not controller.Destroyed then controller:Destroy() end
    end)
    env.__RiseOpenButtonController = controller
    window.RiseOpenButtonController = controller
    restorePosition()
    controller:SetStyle(controller.Style, false)
end
