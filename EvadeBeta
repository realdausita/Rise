function getDistanceFromCamera(targetPosition)
local camera = workspace.CurrentCamera
if not camera then return 0 end
return (targetPosition - camera.CFrame.Position).Magnitude
end
function refreshCamCache()
local cam = workspace.CurrentCamera
if not cam then return ESPManager.ESP_CamCache end
local vs = cam.ViewportSize.Y
if vs <= 0 then vs = 800 end
local fov = math.max(cam.FieldOfView, 1)
ESPManager.ESP_CamCache.vs = vs
ESPManager.ESP_CamCache.fov = fov
ESPManager.ESP_CamCache.ppsFactor = vs / (2 * math.tan(math.rad(fov) / 2))
return ESPManager.ESP_CamCache
end
function calculateBoxPixels(distance)
local cache = ESPManager.ESP_CamCache
local dist = math.max(distance, 1)
local pps = cache.ppsFactor / dist
local w = math.clamp(3.4 * pps, 8, 320)
local h = math.clamp(6 * pps, 12, 480)
return w, h
end
