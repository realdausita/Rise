_SHD_num = function(v, d, mn, mx)
local n = tonumber(v)
if not n then return d end
if mn and n < mn then n = mn end
if mx and n > mx then n = mx end
return n
end
_SHD_rgb = function(v, d)
if type(v) == "string" then
local r, g, b = v:match("(%d+)%D+(%d+)%D+(%d+)")
r, g, b = tonumber(r), tonumber(g), tonumber(b)
if r then
local cl = function(x) return math.clamp(math.floor(x or 0), 0, 255) end
return {cl(r), cl(g), cl(b)}
end
end
return d
end
_SHD_skyid = function(v, d)
if type(v) ~= "string" then return d end
v = v:gsub("%s+", "")
if v == "" then return d end
if v:match("^%d+$") then return "rbxassetid://" .. v end
return v
end
