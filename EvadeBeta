function updateGenericESP(targets, color, settings, elementsTable)
if not settings.Boxes and not settings.Names and not settings.Distance then
if next(elementsTable) == nil then return end
targets = {}
end
local cam = workspace.CurrentCamera
local currentTargets = {}
local seenThisPass = {}
for _, target in ipairs(targets) do
local model = target.model
if not model or not model.Parent then continue end
if seenThisPass[model] then continue end
seenThisPass[model] = true
if ESPManager.ESP_Dedupe[model] then continue end
ESPManager.ESP_Dedupe[model] = true
local rootPart = getRootPart(model)
if not rootPart then continue end
local rootPos = rootPart.Position
local dist = getDistanceFromCamera(rootPos)
if ESP.RangeEnabled and dist > ESP.RangeMax then
if elementsTable[model] then
local old = elementsTable[model]
if old.box2D then remove2DBox(model); old.box2D = nil end
if old.box3D then remove3DBox(model); old.box3D = nil end
if old.billboard then
local b = model:FindFirstChild("ESP_Billboard")
if b then b:Destroy() end
local rb = rootPart:FindFirstChild("ESP_Billboard")
if rb then rb:Destroy() end
old.billboard = nil
end
killTracer(old)
elementsTable[model] = nil
end
continue end
if cam then
local okVp, _, onScreen = pcall(cam.WorldToViewportPoint, cam, rootPos)
if okVp and not onScreen then
if elementsTable[model] then
local old2 = elementsTable[model]
if old2.billboard and old2.billboard.billboard then
old2.billboard.billboard.Enabled = false
end
if old2.box2D and old2.box2D.billboard then
old2.box2D.billboard.Enabled = false
end
end
currentTargets[model] = true
continue
end
end
currentTargets[model] = true
if not elementsTable[model] then elementsTable[model] = {} end
local esp = elementsTable[model]
esp.rootPart = rootPart
local isFar = dist > 600
local bw, bh
if settings.Boxes and (not isFar or ESPManager.UpdateCounter % 2 == 0) then
bw, bh = calculateBoxPixels(dist)
else
if esp.box2D then bw = esp.box2D.bw; bh = esp.box2D.bh end
end
if settings.Boxes and bw then
local nowBB = os.clock()
if not esp.bbT or nowBB - esp.bbT > 5 then
esp.bbT = nowBB
esp.bbSX, esp.bbSY = nil, nil
pcall(function()
local _, bsz = model:GetBoundingBox()
if bsz and bsz.X >= 0.5 and bsz.X <= 6 and bsz.Y >= 1 and bsz.Y <= 9 then
esp.bbSX, esp.bbSY = bsz.X, bsz.Y
end
end)
end
if esp.bbSX and esp.bbSY then
local pps = ESPManager.ESP_CamCache.ppsFactor / math.max(dist, 1)
bw = math.clamp(esp.bbSX * pps, 8, 320)
bh = math.clamp(esp.bbSY * pps, 12, 480)
end
end
if esp.billboard and esp.billboard.billboard then esp.billboard.billboard.Enabled = true end
if esp.box2D and esp.box2D.billboard then esp.box2D.billboard.Enabled = true end
if settings.Boxes then
if settings.BoxType == "3D" then
if not esp.box3D then
if ESPManager.BudgetBox > 0 then
ESPManager.BudgetBox = ESPManager.BudgetBox - 1
local ok3d, box = pcall(create3DBoxForModel, model, settings.BoxColor or color)
if ok3d then esp.box3D = box esp.boxColor = settings.BoxColor or color end
end
elseif esp.boxColor ~= (settings.BoxColor or color) then
esp.boxColor = settings.BoxColor or color
update3DBoxColor(model, esp.boxColor)
end
if esp.box2D then
remove2DBox(model)
esp.box2D = nil
end
else
local mode = settings.BoxMode or "Full Box"
if not bw or not bh then bw, bh = calculateBoxPixels(dist) end
if not esp.box2D or esp.boxMode ~= mode then
if ESPManager.BudgetBox > 0 then
ESPManager.BudgetBox = ESPManager.BudgetBox - 1
local ok2d, box = pcall(create2DBoxForModel, model, settings.BoxColor or color, bw, bh, mode, settings.BoxThick)
if ok2d then esp.box2D = box esp.boxMode = mode end
end
else
pcall(update2DBox, esp.box2D, settings.BoxColor or color, bw, bh, mode, settings.BoxThick)
end
if esp.box3D then
remove3DBox(model)
esp.box3D = nil
end
end
else
if esp.box2D then remove2DBox(model); esp.box2D = nil end
if esp.box3D then remove3DBox(model); esp.box3D = nil end
end
if settings.Names or settings.Distance then
if not esp.billboard then
if ESPManager.BudgetBB > 0 then
ESPManager.BudgetBB = ESPManager.BudgetBB - 1
local okbb, bb = pcall(createBillboardForModel, model, target.name, settings.NameColor or color, settings.NameSize, settings.NameTransp, settings.NameFont, settings.DistSize, settings.DistTransp, settings.DistFont)
if okbb then esp.billboard = bb end
end
end
if esp.billboard and esp.billboard.billboard then
local wantMaxD = ESP.RangeEnabled and ESP.RangeMax or 2500
if esp.billboard._lastMaxD ~= wantMaxD then
esp.billboard._lastMaxD = wantMaxD
esp.billboard.billboard.MaxDistance = wantMaxD
end
end
local showDist = settings.Distance and dist or nil
pcall(updateBillboard, esp.billboard, settings.Names and target.name or nil, showDist, settings.NameColor or color, settings.DistanceColor or color, settings.NameSize, settings.NameTransp, settings.NameFont, settings.DistSize, settings.DistTransp, settings.DistFont, settings.DistMode)
else
if esp.billboard then
local b0 = model:FindFirstChild("ESP_Billboard")
if b0 then b0:Destroy() end
local root = getRootPart(model)
if root then
local bill = root:FindFirstChild("ESP_Billboard")
if bill then bill:Destroy() end
end
esp.billboard = nil
end
end
end
for model, esp in pairs(elementsTable) do
if not currentTargets[model] then
if esp.box2D then remove2DBox(model) end
if esp.box3D then remove3DBox(model) end
killTracer(esp)
if esp.billboard then
local b1 = model:FindFirstChild("ESP_Billboard")
if b1 then b1:Destroy() end
local rootPart = getRootPart(model)
if rootPart then
local bill = rootPart:FindFirstChild("ESP_Billboard")
if bill then bill:Destroy() end
end
end
elementsTable[model] = nil
end
end
end
