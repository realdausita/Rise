function create2DBoxForModel(model, color, w, h, mode, thick)
local rootPart = getRootPart(model)
if not rootPart then return nil end
thick = tonumber(thick) or 1
local existing = model:FindFirstChild("ESP_2DBox")
if existing then existing:Destroy() end
local oldInRoot = rootPart:FindFirstChild("ESP_2DBox")
if oldInRoot then oldInRoot:Destroy() end
local billboard = Instance.new("BillboardGui")
billboard.Name = "ESP_2DBox"
billboard.Adornee = rootPart
billboard.Parent = model
billboard.AlwaysOnTop = true
billboard.Size = UDim2.new(0, w, 0, h)
billboard.StudsOffset = Vector3.new(0, 0.5, 0)
billboard.ClipsDescendants = false
if ESP.RangeEnabled then
billboard.MaxDistance = ESP.RangeMax
else
billboard.MaxDistance = 2500
end
local boxFrame = Instance.new("Frame")
boxFrame.Name = "BoxFrame"
boxFrame.Size = UDim2.new(1, 0, 1, 0)
boxFrame.BackgroundTransparency = 1
boxFrame.BorderSizePixel = 0
boxFrame.Parent = billboard
local uiStroke = Instance.new("UIStroke")
uiStroke.Thickness = math.clamp((w / 40) * thick, 1, 8)
uiStroke.Transparency = 0
uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
uiStroke.Color = color
uiStroke.Parent = boxFrame
local cl = nil
local uc = nil
if mode == "Cornered Box" then
uiStroke.Enabled = false
cl = {}
local cct = math.clamp(math.min(w or 100, h or 100) / 45, 1, 2) * (thick or 1)
local spots = {
{0, 0, 0, 0, 0.22, 0, 0, 2},
{0, 0, 0, 0, 0, 2, 0.22, 0},
{0.78, 0, 0, 0, 0.22, 0, 0, 2},
{1, 0, 0, 0, 0, 2, 0.22, 0},
{0, 0, 1, 0, 0.22, 0, 0, 2},
{0, 0, 0.78, 0, 0, 2, 0.22, 0},
{0.78, 0, 1, 0, 0.22, 0, 0, 2},
{1, 0, 0.78, 0, 0, 2, 0.22, 0},
}
for _, s in ipairs(spots) do
local f = Instance.new("Frame")
f.Position = UDim2.new(s[1], s[2], s[3], s[4])
local csx, csy = s[6], s[8]
if csx == 2 then csx = cct end
if csy == 2 then csy = cct end
f.Size = UDim2.new(s[5], csx, s[7], csy)
f.BackgroundColor3 = color
f.BorderSizePixel = 0
f.Parent = boxFrame
table.insert(cl, f)
end
elseif mode == "Rounded Box" then
uc = Instance.new("UICorner")
uc.CornerRadius = UDim.new(0, 10)
uc.Parent = boxFrame
end
return {
billboard = billboard,
boxFrame = boxFrame,
stroke = uiStroke,
bw = w,
bh = h,
corners = cl,
ucorner = uc,
thick = thick,
_lastColor = color,
ct = cl and math.clamp(math.min(w or 100, h or 100) / 45, 1, 2) * (thick or 1) or nil,
}
end
function update2DBox(boxData, color, w, h, mode, thick)
if boxData then
thick = tonumber(thick) or boxData.thick or 1
if boxData._lastColor ~= color then
boxData._lastColor = color
if boxData.stroke then
boxData.stroke.Color = color
end
if boxData.corners then
for _, f in ipairs(boxData.corners) do
f.BackgroundColor3 = color
end
end
end
if boxData.stroke then
if mode == "Cornered Box" then
boxData.stroke.Enabled = false
else
boxData.stroke.Enabled = true
end
end
if boxData.corners then
if boxData.thick ~= thick or not boxData.ct then
local cct = math.clamp(math.min(w or 100, h or 100) / 45, 1, 2) * thick
if boxData.ct == nil or math.abs(boxData.ct - cct) > 0.25 then
boxData.ct = cct
for _, f in ipairs(boxData.corners) do
local sz = f.Size
if sz.X.Scale == 0 then
f.Size = UDim2.new(sz.X.Scale, cct, sz.Y.Scale, sz.Y.Offset)
else
f.Size = UDim2.new(sz.X.Scale, sz.X.Offset, sz.Y.Scale, cct)
end
end
end
end
end
boxData.thick = thick
if mode == "Rounded Box" then
if not boxData.ucorner then
boxData.ucorner = Instance.new("UICorner")
boxData.ucorner.CornerRadius = UDim.new(0, 10)
boxData.ucorner.Parent = boxData.boxFrame
end
elseif boxData.ucorner then
boxData.ucorner:Destroy()
boxData.ucorner = nil
end
if boxData.billboard then
boxData.billboard.Size = UDim2.new(0, w, 0, h)
local wantMaxD = ESP.RangeEnabled and ESP.RangeMax or 2500
if boxData._lastMaxD ~= wantMaxD then
boxData._lastMaxD = wantMaxD
boxData.billboard.MaxDistance = wantMaxD
end
end
if boxData.stroke then
boxData.stroke.Thickness = math.clamp((w / 40) * thick, 1, 8)
end
boxData.bw = w
boxData.bh = h
end
end
