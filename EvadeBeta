_SHD.write = function(p)
if not p then return end
local L = Lighting
pcall(function()
L.Brightness = p.bright
L.ClockTime = p.clock
L.GeographicLatitude = p.geo
L.ExposureCompensation = p.expo
L.Ambient = _SHD_C3(p.amb)
L.OutdoorAmbient = _SHD_C3(p.out)
L.ShadowSoftness = p.shadow
L.EnvironmentDiffuseScale = p.diff
L.EnvironmentSpecularScale = p.spec
end)
local sky = L:FindFirstChildOfClass("Sky")
if not sky then sky = Instance.new("Sky") sky.Parent = L end
pcall(function()
sky.SkyboxBk = p.sky.bk
sky.SkyboxDn = p.sky.dn
sky.SkyboxFt = p.sky.ft
sky.SkyboxLf = p.sky.lf
sky.SkyboxRt = p.sky.rt
sky.SkyboxUp = p.sky.up
sky.SunAngularSize = p.sky.sun
sky.MoonAngularSize = p.sky.moon
sky.StarCount = p.sky.stars
sky.CelestialBodiesShown = p.sky.cel ~= false
end)
local atm = L:FindFirstChildOfClass("Atmosphere")
if not atm then atm = Instance.new("Atmosphere") atm.Parent = L end
pcall(function()
atm.Color = _SHD_C3(p.atm.c)
atm.Decay = _SHD_C3(p.atm.d)
atm.Density = p.atm.den
atm.Offset = p.atm.off
atm.Glare = p.atm.g
atm.Haze = p.atm.h
end)
local bloom = L:FindFirstChild("Bloom")
if not bloom then bloom = Instance.new("BloomEffect") bloom.Name = "Bloom" bloom.Parent = L end
pcall(function()
bloom.Enabled = p.bloom.on ~= false
bloom.Intensity = p.bloom.i
bloom.Size = p.bloom.s
bloom.Threshold = p.bloom.t
end)
local dof = L:FindFirstChild("DepthOfField")
if dof then pcall(function()
dof.Enabled = p.dof.on == true
dof.FocusDistance = p.dof.f
dof.InFocusRadius = p.dof.r
dof.NearIntensity = p.dof.n
dof.FarIntensity = p.dof.far
end) end
local sr = L:FindFirstChild("SunRays")
