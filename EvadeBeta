_SHD.snap = function()
if _SHD.orig then return end
local L = Lighting
local sky = L:FindFirstChildOfClass("Sky")
local atm = L:FindFirstChildOfClass("Atmosphere")
local bloom = L:FindFirstChild("Bloom")
local dof = L:FindFirstChild("DepthOfField")
local sr = L:FindFirstChild("SunRays")
local cc = L:FindFirstChild("ColorCorrection")
local t = {
bright = L.Brightness, clock = L.ClockTime, geo = L.GeographicLatitude, expo = L.ExposureCompensation,
amb = {math.floor(L.Ambient.R * 255 + 0.5), math.floor(L.Ambient.G * 255 + 0.5), math.floor(L.Ambient.B * 255 + 0.5)},
out = {math.floor(L.OutdoorAmbient.R * 255 + 0.5), math.floor(L.OutdoorAmbient.G * 255 + 0.5), math.floor(L.OutdoorAmbient.B * 255 + 0.5)},
shadow = L.ShadowSoftness, diff = L.EnvironmentDiffuseScale, spec = L.EnvironmentSpecularScale,
sky = {bk = "", dn = "", ft = "", lf = "", rt = "", up = "", sun = 3, moon = 3, stars = 1000, cel = true},
atm = {c = {200, 200, 200}, d = {200, 200, 200}, den = 0.3, off = 0, g = 0, h = 0},
bloom = {on = true, i = 1, s = 24, t = 2},
dof = {on = false, f = 0.05, r = 30, n = 0.75, far = 0.1},
sunrays = {on = true, i = 0.03, s = 0.1},
cc = {on = true, c = 0, s = 0, t = {255, 255, 255}, b = 0},
}
if sky then pcall(function()
t.sky = {bk = sky.SkyboxBk, dn = sky.SkyboxDn, ft = sky.SkyboxFt, lf = sky.SkyboxLf, rt = sky.SkyboxRt, up = sky.SkyboxUp, sun = sky.SunAngularSize, moon = sky.MoonAngularSize, stars = sky.StarCount, cel = sky.CelestialBodiesShown}
end) end
if atm then pcall(function()
t.atm = {c = {math.floor(atm.Color.R * 255 + 0.5), math.floor(atm.Color.G * 255 + 0.5), math.floor(atm.Color.B * 255 + 0.5)}, d = {math.floor(atm.Decay.R * 255 + 0.5), math.floor(atm.Decay.G * 255 + 0.5), math.floor(atm.Decay.B * 255 + 0.5)}, den = atm.Density, off = atm.Offset, g = atm.Glare, h = atm.Haze}
end) end
if bloom then pcall(function() t.bloom = {on = bloom.Enabled, i = bloom.Intensity, s = bloom.Size, t = bloom.Threshold} end) end
if dof then pcall(function() t.dof = {on = dof.Enabled, f = dof.FocusDistance, r = dof.InFocusRadius, n = dof.NearIntensity, far = dof.FarIntensity} end) end
if sr then pcall(function() t.sunrays = {on = sr.Enabled, i = sr.Intensity, s = sr.Spread} end) end
if cc then pcall(function() t.cc = {on = cc.Enabled, c = cc.Contrast, s = cc.Saturation, t = {math.floor(cc.TintColor.R * 255 + 0.5), math.floor(cc.TintColor.G * 255 + 0.5), math.floor(cc.TintColor.B * 255 + 0.5)}, b = cc.Brightness} end) end
_SHD.orig = t
end
_SHD.apply = function(name)
local p = _SHD_PRESETS[name or _SHD.sel]
if not p then return end
_SHD.snap()
_SHD.sel = name or _SHD.sel
_SHD.write(p)
end
_SHD.restore = function()
if not _SHD.orig then return end
_SHD.write(_SHD.orig)
_SHD.orig = nil
end
_SHD.capture = function()
local keep = _SHD.orig
_SHD.orig = nil
_SHD.snap()
_SHD_PRESETS["Custom"] = _SHD.orig
_SHD.orig = keep
return _SHD_PRESETS["Custom"] ~= nil
end
